{
  "name": "<%= packageName || '@oresoftware/f2e' %>",
  "version": "<%= version || '0.1.0' %>",
  "description": "Node.js bindings for flags2env.",
  "license": "MIT",
  "type": "module",
  "main": "./lib.cjs",
  "types": "./lib.ts",
  "bin": {
    "f2e": "./cli.mjs",
    "flags2env": "./cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib.ts",
      "import": "./lib.mjs",
      "require": "./lib.cjs",
      "default": "./lib.mjs"
    }
  },
  "scripts": {
    "install": "node-gyp rebuild"
  },
  "gypfile": true,
  "files": [
    "lib.mjs",
    "lib.cjs",
    "lib.ts",
    "cli.mjs",
    "addon.c",
    "binding.gyp",
    "src"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "node-gyp": "^10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ORESoftware/flags-2-env.git"
  }
}
