    <license type="expression">MIT</license>
    <projectUrl>https://github.com/ORESoftware/flags-2-env</projectUrl>
    <repository type="git" url="https://github.com/ORESoftware/flags-2-env" />
    <description>C# bindings for flags2env.</description>
    <dependencies>
      <group targetFramework="net6.0">
