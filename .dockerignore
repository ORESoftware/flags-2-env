# Version control and local tooling metadata
.git/
.github/
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# Local env/config files. Test fixture .env files live under tests/ and are
# intentionally left in the build context.
/.env
/.env.*
/.envrc
/.npmrc

# Credentials and host-specific secrets
.aws/
**/.aws/
.azure/
**/.azure/
.gcloud/
**/.gcloud/
.ssh/
**/.ssh/
.netrc
**/.netrc
*.pem
*.key
*.p12
*.pfx
*.crt
*.cert
id_rsa
id_dsa
id_ecdsa
id_ed25519

# Package manager dependency directories and caches
node_modules/
**/node_modules/
vendor/
**/vendor/
.pnpm-store/
.yarn/
.bun/

# Build outputs and coverage reports
build/
**/build/
dist/
**/dist/
target/
**/target/
coverage/
**/coverage/
tmp/
**/tmp/
*.log

# Native/compiler artifacts
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.class
*.jar
*.beam
*.node

# Node/native addon builds
clients/nodejs/build/
clients/nodejs/.node-gyp/

# Rust
clients/rust/target/
clients/rust/Cargo.lock

# Dart
clients/dart/.dart_tool/
clients/dart/pubspec.lock

